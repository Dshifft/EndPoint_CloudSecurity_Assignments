# Application JWT and MFA settings
USER_JWT_SECRET=replace-with-a-long-random-user-secret
ADMIN_JWT_SECRET=replace-with-a-long-random-admin-secret
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-ethereal-username
SMTP_PASSWORD=your-ethereal-password
SMTP_FROM=no-reply@example.com

# PostgreSQL settings for Docker Compose and SQLAlchemy
POSTGRES_DB=voting_db
POSTGRES_USER=voting_user
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=voting_db
POSTGRES_PORT=5432
