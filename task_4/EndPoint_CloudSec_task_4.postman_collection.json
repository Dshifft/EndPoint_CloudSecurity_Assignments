    {
      "name": "0_admin_MFA",
      "item": [
        {
          "name": "Initialize run data and check API",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = pm.variables.replaceIn('{{$randomUUID}}').replace(/-/g, '').slice(0, 12);\npm.environment.set('admin_name', `Admin ${suffix}`);\npm.environment.set('admin_email', `ransom89@ethereal.email`);\npm.environment.set('admin_password', 'Password123!');\npm.environment.set('candidate_name', `Candidate ${suffix}`);\npm.environment.set('candidate_email', `candidate_${suffix}@example.com`);\npm.environment.set('user_name', `Voter ${suffix}`);\npm.environment.set('user_email', `voter_${suffix}@example.com`);\npm.environment.set('user_password', 'Password123!');\npm.environment.set('cleanup_user_name', `Cleanup ${suffix}`);\npm.environment.set('cleanup_user_email', `cleanup_${suffix}@example.com`);\npm.environment.set('cleanup_user_password', 'Password123!');\npm.environment.unset('admin_token');\npm.environment.unset('user_token');\npm.environment.unset('cleanup_user_token');\npm.environment.unset('candidate_id');\npm.environment.unset('vote_id');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));\npm.test('Welcome message is returned', () => pm.expect(pm.response.json().message).to.eql('Welcome to the voting app!'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                ""
              ]
            }
          },
          "response": []
        },
        {
          "name": "Register admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Registered email matches environment', () => pm.expect(pm.response.json().email).to.eql(pm.environment.get('admin_email')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{admin_name}}\",\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/admin/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Request MFA code",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('MFA confirmation is returned', () => pm.expect(pm.response.json().message).to.include('MFA code sent'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/admin/request-mfa",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "request-mfa"
              ]
            }
          },
          "response": []
        }
      ],
      "description": "Run these requests in order. After Request MFA, paste the emailed code in the selected environment variable admin_mfa_code. Do not run this folder with the Runner."
    },
